---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Astro/Navbar.astro';
import Footer from '../../components/Astro/Footer.astro';

export const prerender = false;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive, nosnippet, noimageindex');
const sessionId = Astro.url.searchParams.get('session_id');
---

<Layout
    title="Επιτυχής Κατοχύρωση Ticket | DIGIADS"
    description="Επιβεβαίωση τεχνικού αιτήματος DIGIADS"
    noindex={true}
>
    <Navbar />

    <section class="pt-40 pb-24 px-6 relative overflow-hidden bg-[#1B1F3B] min-h-screen flex items-center justify-center">
        <div class="max-w-xl w-full bg-slate-900 border border-emerald-800/60 rounded-2xl p-8 text-center space-y-5 shadow-2xl">
            <div class="w-16 h-16 mx-auto rounded-full bg-emerald-950 border border-emerald-700 flex items-center justify-center text-emerald-400 text-3xl">
                ✓
            </div>
            <h1 class="text-2xl md:text-3xl font-bold text-white">
                Το Ticket σας Κατοχυρώθηκε Επιτυχώς!
            </h1>
            <p class="text-slate-300 text-sm leading-relaxed">
                Η πληρωμή σας ολοκληρώθηκε και το τεχνικό σας αίτημα μπήκε στην ουρά προτεραιότητας της ομάδας της DIGIADS.
            </p>
            {sessionId && (
                <p class="text-xs font-mono text-slate-500 break-all">
                    Κωδικός Συναλλαγής: {sessionId}
                </p>
            )}
            <div class="pt-4">
                <a
                    href="/support-ticket"
                    class="inline-block px-6 py-3 rounded-lg bg-[#FFBF00] text-black font-bold text-sm hover:opacity-90 transition-opacity"
                >
                    Επιστροφή στο Ticketing System
                </a>
            </div>
        </div>
    </section>

    <Footer />
</Layout>
