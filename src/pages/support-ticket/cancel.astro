---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Astro/Navbar.astro';
import Footer from '../../components/Astro/Footer.astro';

export const prerender = false;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive, nosnippet, noimageindex');
---

<Layout
    title="Ακύρωση Πληρωμής Ticket | DIGIADS"
    description="Ακύρωση πληρωμής τεχνικού αιτήματος DIGIADS"
    noindex={true}
>
    <Navbar />

    <section class="pt-40 pb-24 px-6 relative overflow-hidden bg-[#1B1F3B] min-h-screen flex items-center justify-center">
        <div class="max-w-xl w-full bg-slate-900 border border-amber-800/60 rounded-2xl p-8 text-center space-y-5 shadow-2xl">
            <div class="w-16 h-16 mx-auto rounded-full bg-amber-950 border border-amber-700 flex items-center justify-center text-amber-400 text-3xl">
                !
            </div>
            <h1 class="text-2xl md:text-3xl font-bold text-white">
                Η Πληρωμή Ακυρώθηκε
            </h1>
            <p class="text-slate-300 text-sm leading-relaxed">
                Δεν πραγματοποιήθηκε καμία χρέωση. Μπορείτε να επιστρέψετε στο Ticketing System για να υποβάλετε ξανά το αίτημά σας.
            </p>
            <div class="pt-4">
                <a
                    href="/support-ticket"
                    class="inline-block px-6 py-3 rounded-lg bg-blue-600 text-white font-bold text-sm hover:bg-blue-500 transition-colors"
                >
                    Επιστροφή στο Ticketing System
                </a>
            </div>
        </div>
    </section>

    <Footer />
</Layout>
