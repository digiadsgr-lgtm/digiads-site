---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Astro/Navbar.astro';
import Footer from '../components/Astro/Footer.astro';

const title = "Τουριστικό Marketing Κρήτη | Direct Bookings για Βίλες & Ξενοδοχεία | DIGIADS";
const description = "Η Νο1 εταιρεία Tourism Marketing στην Κρήτη. Μειώστε την εξάρτηση από Booking.com & Airbnb. Custom booking engines, στοχευμένη διαφήμιση, AI-search ready. Ζητήστε προσφορά!";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Πώς μπορώ να μειώσω την εξάρτηση από Booking.com και Airbnb;",
      "acceptedAnswer": { "@type": "Answer", "text": "Χτίζοντας ένα ισχυρό direct booking κανάλι: γρήγορη ιστοσελίδα με ενσωματωμένη μηχανή κρατήσεων, στοχευμένη διαφήμιση Google & Meta, και κίνητρα (καλύτερη τιμή, extras) που ωθούν τον επισκέπτη να κλείσει απευθείας αντί μέσω πλατφόρμας." }},
    { "@type": "Question", "name": "Πόσο κοστίζει το τουριστικό marketing για μια βίλα ή ξενοδοχείο;",
      "acceptedAnswer": { "@type": "Answer", "text": "Εξαρτάται από τον αριθμό καταλυμάτων, τον στόχο (νέα ιστοσελίδα, διαφήμιση, ή πλήρες πακέτο) και το επίπεδο διεθνούς στόχευσης. Ζητήστε δωρεάν αξιολόγηση για εξατομικευμένη προσφορά βάσει του καταλύματός σας." }},
    { "@type": "Question", "name": "Αναλαμβάνετε και ξενοδοχειακές μονάδες, όχι μόνο βίλες;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Εξειδικευόμαστε σε boutique ξενοδοχεία, πολυτελείς βίλες, ενοικιαζόμενα δωμάτια και καταλύματα Airbnb, με στρατηγική προσαρμοσμένη στην κλίμακα και το προφίλ φιλοξενούμενων κάθε μονάδας." }},
    { "@type": "Question", "name": "Τι διαφορά έχει το τουριστικό marketing από το γενικό digital marketing;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ο τουρισμός έχει έντονη εποχικότητα, διεθνές κοινό, μεγάλο κύκλο απόφασης (μήνες πριν την κράτηση) και ανταγωνισμό από OTA πλατφόρμες με τεράστια διαφημιστικά budget. Χρειάζεται στρατηγική που συνδυάζει branding, στοχευμένη διεθνή διαφήμιση και βελτιστοποιημένο booking funnel, ειδικά φτιαγμένη για αυτές τις ιδιαιτερότητες." }},
    { "@type": "Question", "name": "Πόσο νωρίς πρέπει να ξεκινήσω τη στρατηγική marketing πριν τη σεζόν;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ιδανικά 4-6 μήνες πριν, καθώς πολλοί ταξιδιώτες σχεδιάζουν και κλείνουν το κατάλυμά τους νωρίς. Η awareness καμπάνια τον χειμώνα χτίζει το κοινό που θα κάνει κράτηση την άνοιξη." }},
    { "@type": "Question", "name": "Βοηθάτε το κατάλυμά μου να εμφανίζεται σε AI αναζητήσεις (ChatGPT, Google AI Overviews);",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Όλο και περισσότεροι ταξιδιώτες ρωτούν AI εργαλεία για προτάσεις καταλυμάτων πριν καν ανοίξουν μια πλατφόρμα κράτησης. Εφαρμόζουμε structured data (Hotel/LodgingBusiness schema) και στρατηγική περιεχομένου ώστε το κατάλυμά σας να εμφανίζεται σε αυτές τις απαντήσεις." }}
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Τουριστικό Marketing & Direct Booking Strategy",
  "provider": { "@id": "https://www.digiads.gr/#organization" },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Κρήτη" },
    { "@type": "City", "name": "Ρέθυμνο" },
    { "@type": "City", "name": "Χανιά" },
    { "@type": "City", "name": "Ηράκλειο" }
  ],
  "description": "Ολοκληρωμένο τουριστικό digital marketing για βίλες, ξενοδοχεία και καταλύματα στην Κρήτη, με στόχο την αύξηση direct bookings και τη μείωση εξάρτησης από OTA πλατφόρμες.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog", "name": "Υπηρεσίες Tourism Marketing",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Booking Engine Websites" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Targeted Google & Meta Ads για Τουρισμό" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Aesthetic Brand Image & Photography" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Direct Booking Strategy & OTA Reduction" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Search / GEO Optimization για Καταλύματα" }}
    ]
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Αρχική", "item": "https://www.digiads.gr/" },
    { "@type": "ListItem", "position": 2, "name": "Τουριστικό Marketing", "item": "https://www.digiads.gr/touristiko-marketing" }
  ]
};
---

<Layout title={title} description={description} lang="el">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <Navbar />

    {/* Hero Split Layout for Luxury Tourism */}
    <section class="relative pt-32 pb-24 bg-[#010205] min-h-screen flex items-center overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,183,255,0.05)_0%,transparent_60%)] pointer-events-none" />
        
        <div class="max-w-[1400px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10 w-full">
            
            {/* Massive Visual */}
            <div class="lg:col-span-7 relative group h-[50vh] lg:h-[80vh] w-full rounded-[2rem] overflow-hidden bg-[#0a0d16] border border-white/10 order-2 lg:order-1 shadow-2xl">
                <img src="/visuals/tourism_luxury.png" alt="Luxury Villa Infinity Pool Crete Tourism" class="w-full h-full object-cover scale-[1.03] group-hover:scale-[1.08] transition-transform duration-[3s] ease-out origin-center" loading="eager" />
                <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-[#010205]/90 via-[#010205]/40 to-transparent pointer-events-none"></div>
                <div class="absolute top-8 right-8">
                     <span class="px-4 py-2 bg-black/50 backdrop-blur-md text-white border border-white/20 rounded-full text-xs font-bold tracking-widest uppercase">
                         5★ Premium Guest
                     </span>
                </div>
            </div>

            {/* Text Content */}
            <div class="lg:col-span-5 order-1 lg:order-2 lg:pl-10">
                <span class="text-[#00d9ff] font-mono tracking-[0.2em] uppercase text-xs mb-6 inline-block font-bold">Direct Bookings Mastery</span>
                <h1 class="text-4xl md:text-5xl lg:text-7xl font-black text-white font-montserrat tracking-tight leading-[1.1] mb-8">
                    Τουριστικό<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-[#00d9ff]">Marketing.</span>
                </h1>
                <p class="text-lg text-slate-300 font-light leading-relaxed mb-10">
                    Απελευθερωθείτε από τις εξοντωτικές προμήθειες (15-20%) των <strong>OTA πλατφορμών (Booking.com, Airbnb)</strong>. Αναλαμβάνουμε την πλήρη ψηφιακή ταυτότητα και προώθηση του καταλύματός σας στην Κρήτη, προσελκύοντας <strong>Direct Bookings</strong> από premium πελατολόγιο του εξωτερικού.
                </p>
                
                <a href="/contact" class="px-8 py-4 bg-gradient-to-r from-[#00d9ff] to-blue-600 text-white font-bold rounded-full hover:scale-105 transition-transform shadow-[0_0_20px_rgba(0,217,255,0.3)] inline-block uppercase tracking-wider">
                    ΑΥΞΗΣΤΕ ΤΑ ΚΕΡΔΗ ΣΑΣ
                </a>
            </div>
            
        </div>
    </section>

    <!-- NEW SECTION 1: Service Cards (Upgraded from the 3 bullets) -->
    <section class="py-24 bg-[#010205] relative border-t border-white/5 z-10">
        <div class="max-w-6xl mx-auto px-6">
            <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat text-center mb-16">Οι 3 Πυλώνες της Στρατηγικής μας</h2>
            <div class="grid lg:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="bg-[#050814]/80 backdrop-blur-md p-10 rounded-3xl border border-white/5 hover:border-[#00d9ff]/30 transition-colors duration-500 group">
                    <div class="w-12 h-12 rounded-full border border-[#00d9ff]/30 flex items-center justify-center text-[#00d9ff] font-mono font-bold mb-6 group-hover:bg-[#00d9ff]/10 transition-colors">01</div>
                    <h3 class="text-2xl font-bold text-white mb-4">Custom Booking Engine Websites</h3>
                    <p class="text-slate-400 leading-relaxed font-light">Μια <a href="/kataskevi-istoselidon" class="text-[#00d9ff] hover:underline">custom ιστοσελίδα</a> με ενσωματωμένη μηχανή κρατήσεων (booking engine), χτισμένη σε σύγχρονο framework για μέγιστη ταχύτητα. Ο επισκέπτης κλείνει σε λίγα κλικ, με απόλυτη ασφάλεια και <strong>χωρίς καμία προμήθεια</strong> πλατφόρμας.</p>
                </div>
                <!-- Service 2 -->
                <div class="bg-[#050814]/80 backdrop-blur-md p-10 rounded-3xl border border-white/5 hover:border-blue-500/30 transition-colors duration-500 group">
                    <div class="w-12 h-12 rounded-full border border-blue-500/30 flex items-center justify-center text-blue-500 font-mono font-bold mb-6 group-hover:bg-blue-500/10 transition-colors">02</div>
                    <h3 class="text-2xl font-bold text-white mb-4">Targeted Google & Meta Ads</h3>
                    <p class="text-slate-400 leading-relaxed font-light">Στοχευμένες καμπάνιες αναζήτησης (Google Ads) που πιάνουν τον ταξιδιώτη στη φάση σχεδιασμού του ταξιδιού του, σε συνδυασμό με <a href="/social-media/diafimisi-facebook-instagram" class="text-blue-400 hover:underline">retargeting σε Facebook & Instagram</a> για μέγιστη απήχηση και μετατροπή.</p>
                </div>
                <!-- Service 3 -->
                <div class="bg-[#050814]/80 backdrop-blur-md p-10 rounded-3xl border border-white/5 hover:border-purple-500/30 transition-colors duration-500 group">
                    <div class="w-12 h-12 rounded-full border border-purple-500/30 flex items-center justify-center text-purple-400 font-mono font-bold mb-6 group-hover:bg-purple-500/10 transition-colors">03</div>
                    <h3 class="text-2xl font-bold text-white mb-4">Aesthetic Brand Image</h3>
                    <p class="text-slate-400 leading-relaxed font-light">Επαγγελματική φωτογράφιση, <a href="/photo-services/drone-services" class="text-purple-400 hover:underline">drone βίντεο</a>, <a href="/social-media/tiktok-reels" class="text-purple-400 hover:underline">viral short-form content</a> και <a href="/social-media/influencer-marketing" class="text-purple-400 hover:underline">Influencer & Content Creator συνεργασίες</a> που μεταφέρουν την πολυτέλεια και την εμπειρία του καταλύματός σας πριν καν φτάσει ο επισκέπτης.</p>>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION 2: Γιατί Direct Bookings (Comparison) -->
    <section class="py-24 bg-[#02040A] relative border-t border-white/5">
        <div class="max-w-5xl mx-auto px-6">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div class="prose prose-invert prose-lg prose-headings:font-montserrat leading-[1.7]">
                    <h2 class="text-3xl font-bold text-white mb-6">Γιατί οι Direct Bookings Αλλάζουν τα Οικονομικά του Καταλύματός σας</h2>
                    <p class="text-slate-300 font-light">
                        Κάθε κράτηση μέσω <strong>Booking.com ή Airbnb</strong> σας κοστίζει 15-20% σε προμήθεια. Πολλαπλασιάστε το σε μια ολόκληρη σεζόν και μιλάμε για δεκάδες χιλιάδες ευρώ που θα μπορούσαν να μείνουν καθαρό κέρδος στο κατάλυμά σας.
                    </p>
                    <p class="text-slate-300 font-light mt-4">
                        Πέρα από το οικονομικό όφελος, οι <strong>direct κρατήσεις</strong> σας δίνουν την απόλυτη ιδιοκτησία της σχέσης με τον επισκέπτη — πραγματικά στοιχεία επικοινωνίας, δυνατότητα επαναπροσέγγισης (email marketing), και πλήρη έλεγχο στην τιμολόγηση χωρίς τους αυστηρούς περιορισμούς των OTA (Online Travel Agencies). <a href="/blog/direct-bookings" class="text-[#00d9ff] hover:underline">Διαβάστε τον αναλυτικό οδηγό μας</a>.
                    </p>
                </div>
                
                <!-- Editorial Comparison Visual -->
                <div class="bg-[#050814]/50 border border-white/5 p-8 rounded-[2rem]">
                    <h3 class="text-white font-bold mb-8 uppercase tracking-widest text-sm text-center">Καθαρο Εσοδο ανα Κρατηση</h3>
                    
                    <div class="space-y-8">
                        <!-- OTA Bar -->
                        <div>
                            <div class="flex justify-between text-sm mb-2 font-mono">
                                <span class="text-slate-400">Μέσω OTA (Booking/Airbnb)</span>
                                <span class="text-red-400 font-bold">~80%</span>
                            </div>
                            <div class="h-3 w-full bg-white/5 rounded-full overflow-hidden flex">
                                <div class="h-full bg-red-500/80 w-[80%] rounded-l-full"></div>
                                <div class="h-full bg-red-900/30 w-[20%] relative group">
                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                        <span class="text-[8px] font-bold text-white uppercase tracking-wider">-20% Προμηθεια</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Direct Bar -->
                        <div>
                            <div class="flex justify-between text-sm mb-2 font-mono">
                                <span class="text-white font-bold">Direct Booking (Δικό σας Site)</span>
                                <span class="text-[#00d9ff] font-bold">100%</span>
                            </div>
                            <div class="h-3 w-full bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-[#00d9ff] to-blue-500 w-full rounded-full shadow-[0_0_15px_rgba(0,217,255,0.4)]"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION 3: Process -->
    <section class="py-24 bg-[#010205] relative border-t border-white/5">
        <div class="max-w-4xl mx-auto px-6">
            <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat text-center mb-16">Η Στρατηγική μας για το Κατάλυμά σας</h2>
            
            <div class="space-y-8">
                <!-- Step 1 -->
                <div class="flex gap-6 group">
                    <div class="flex flex-col items-center">
                        <div class="w-12 h-12 rounded-full border border-white/10 bg-[#050814] flex items-center justify-center text-white font-mono font-bold group-hover:border-[#00d9ff] group-hover:text-[#00d9ff] transition-colors z-10">1</div>
                        <div class="w-[1px] h-full bg-gradient-to-b from-white/10 to-transparent mt-4 group-hover:from-[#00d9ff]/50 transition-colors"></div>
                    </div>
                    <div class="pb-10 pt-2">
                        <h3 class="text-2xl font-bold text-white mb-3">Ανάλυση & Θέση στην Αγορά</h3>
                        <p class="text-slate-400 font-light leading-relaxed">Μελετάμε σε βάθος το κατάλυμα, τον άμεσο ανταγωνισμό στην περιοχή (π.χ. <a href="/blog/local-seo-rethymno" class="text-blue-400 hover:underline">Ρέθυμνο ή Χανιά</a>) και το ιδανικό προφίλ του επισκέπτη σας (ideal guest persona).</p>
                    </div>
                </div>
                <!-- Step 2 -->
                <div class="flex gap-6 group">
                    <div class="flex flex-col items-center">
                        <div class="w-12 h-12 rounded-full border border-white/10 bg-[#050814] flex items-center justify-center text-white font-mono font-bold group-hover:border-[#00d9ff] group-hover:text-[#00d9ff] transition-colors z-10">2</div>
                        <div class="w-[1px] h-full bg-gradient-to-b from-white/10 to-transparent mt-4 group-hover:from-[#00d9ff]/50 transition-colors"></div>
                    </div>
                    <div class="pb-10 pt-2">
                        <h3 class="text-2xl font-bold text-white mb-3">Ψηφιακή Ταυτότητα</h3>
                        <p class="text-slate-400 font-light leading-relaxed">Κατασκευή custom ιστοσελίδας, επαγγελματική φωτογράφιση και δημιουργία ενός luxury brand image που αντικατοπτρίζει την πραγματική 5-star εμπειρία του καταλύματος.</p>
                    </div>
                </div>
                <!-- Step 3 -->
                <div class="flex gap-6 group">
                    <div class="flex flex-col items-center">
                        <div class="w-12 h-12 rounded-full border border-white/10 bg-[#050814] flex items-center justify-center text-white font-mono font-bold group-hover:border-[#00d9ff] group-hover:text-[#00d9ff] transition-colors z-10">3</div>
                        <div class="w-[1px] h-full bg-gradient-to-b from-white/10 to-transparent mt-4 group-hover:from-[#00d9ff]/50 transition-colors"></div>
                    </div>
                    <div class="pb-10 pt-2">
                        <h3 class="text-2xl font-bold text-white mb-3">Στοχευμένη Προβολή</h3>
                        <p class="text-slate-400 font-light leading-relaxed">Google Ads, Meta Ads και οργανικό social content σε στοχευμένο διεθνές κοινό, τη στιγμή ακριβώς που βρίσκονται στη φάση του ταξιδιωτικού τους σχεδιασμού.</p>
                    </div>
                </div>
                <!-- Step 4 -->
                <div class="flex gap-6 group">
                    <div class="flex flex-col items-center">
                        <div class="w-12 h-12 rounded-full border border-[#00d9ff] bg-[#00d9ff]/10 flex items-center justify-center text-[#00d9ff] font-mono font-bold shadow-[0_0_15px_rgba(0,217,255,0.3)] z-10">4</div>
                    </div>
                    <div class="pt-2">
                        <h3 class="text-2xl font-bold text-white mb-3">Βελτιστοποίηση & Επαναλαμβανόμενες Κρατήσεις</h3>
                        <p class="text-slate-400 font-light leading-relaxed">Email marketing, retargeting list building και data analysis για συνεχή αύξηση του direct booking rate χρόνο με τον χρόνο.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION 4: AI Search Ready (Competitive Advantage) -->
    <section class="py-20 bg-gradient-to-b from-[#02040A] to-[#010205] relative border-t border-white/5 overflow-hidden">
        <div class="absolute right-0 top-1/2 -translate-y-1/2 opacity-5 pointer-events-none text-white">
            <svg class="w-96 h-96" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
        </div>
        
        <div class="max-w-4xl mx-auto px-6 relative z-10">
            <div class="flex items-center gap-4 mb-6">
                <span class="px-3 py-1 rounded-full border border-[#00d9ff]/30 bg-[#00d9ff]/10 text-[#00d9ff] text-xs font-mono font-bold tracking-widest uppercase">GEO Optimization</span>
                <span class="px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/10 text-purple-400 text-xs font-mono font-bold tracking-widest uppercase">AI-Search Ready</span>
            </div>
            
            <h2 class="text-3xl font-bold text-white mb-6">Ορατότητα στην Εποχή του AI Search</h2>
            <div class="prose prose-invert prose-lg font-light leading-[1.8] text-slate-300">
                <p>
                    Ο τρόπος που οι ταξιδιώτες αναζητούν κατάλυμα αλλάζει. Όλο και περισσότεροι ρωτούν <strong>AI εργαλεία (ChatGPT, Google AI Overviews, Gemini)</strong> με prompts όπως <em>«ποιο είναι το καλύτερο boutique κατάλυμα στο Ρέθυμνο με πισίνα;»</em> πριν καν ανοίξουν το Booking.com ή το Google Search.
                </p>
                <p>
                    Στη DIGIADS, δεν μένουμε στο παραδοσιακό SEO. Εφαρμόζουμε <strong>Generative Engine Optimization (GEO)</strong>. Ενσωματώνουμε εξειδικευμένο <code>Hotel/LodgingBusiness structured data (Schema.org)</code> και AI-readable metadata (όπως το <code>meta-llm-opt</code> tag) στον κώδικα της ιστοσελίδας σας. 
                </p>
                <p>
                    Αυτή η τεχνολογική υποδομή διασφαλίζει ότι τα Μεγάλα Γλωσσικά Μοντέλα (LLMs) μπορούν να «διαβάσουν» και να προτείνουν τη δική σας βίλα ή ξενοδοχείο στις απαντήσεις τους. Είναι ένα κρίσιμο τεχνολογικό πλεονέκτημα που ελάχιστα agencies στην Ελλάδα προσφέρουν σήμερα.
                </p>
            </div>
        </div>
    </section>

    <!-- NEW SECTION 5: Property Types -->
    <section class="py-24 bg-[#010205] relative border-t border-white/5">
        <div class="max-w-6xl mx-auto px-6">
            <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat text-center mb-16">Εξειδίκευση σε Κάθε Τύπο Καταλύματος</h2>
            
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Luxury Villas -->
                <div class="group cursor-pointer">
