---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Astro/Navbar.astro';
import Footer from '../components/Astro/Footer.astro';
import SiteAuditor from '../components/React/SiteAuditor';
import TechShowcase from '../components/React/TechShowcase';

const title = "Κατασκευή Ιστοσελίδων & E-shop Κρήτη | Web Design Ρέθυμνο | DIGIADS";
const description = "Custom κατασκευή ιστοσελίδων & e-shop στην Κρήτη (Ρέθυμνο, Χανιά, Ηράκλειο). 100/100 ταχύτητα σε Next.js/Astro. Δημιουργία ιστοσελίδας που πουλάει. Ζητήστε προσφορά!";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Πόσο κοστίζει η κατασκευή ιστοσελίδας;",
      "acceptedAnswer": { "@type": "Answer", "text": "Το κόστος εξαρτάται από τον τύπο (εταιρική παρουσίαση ή e-shop) και τις λειτουργίες. Μια custom εταιρική ιστοσελίδα ξεκινά από ανταγωνιστικό πάγιο, ενώ τα e-shop κοστολογούνται βάσει διασυνδέσεων (ERP, τράπεζες) και αριθμού προϊόντων. Ζητήστε δωρεάν, χωρίς δέσμευση προσφορά." }},
    { "@type": "Question", "name": "Πόσος χρόνος χρειάζεται για την κατασκευή μιας ιστοσελίδας;",
      "acceptedAnswer": { "@type": "Answer", "text": "Μια εταιρική ιστοσελίδα ολοκληρώνεται σε 15-20 εργάσιμες ημέρες, ενώ ένα e-shop απαιτεί 30-45 ημέρες ανάλογα με την πολυπλοκότητα των διασυνδέσεων (ERP, τράπεζες)." }},
    { "@type": "Question", "name": "Οι ιστοσελίδες σας βγαίνουν στην πρώτη σελίδα της Google;",
      "acceptedAnswer": { "@type": "Answer", "text": "Χτίζουμε σε Next.js και Astro με δείκτες Core Web Vitals 100/100, δίνοντας τεράστιο προβάδισμα έναντι ανταγωνισμού που χρησιμοποιεί WordPress." }},
    { "@type": "Question", "name": "Τι διαφορά έχει το custom web design από ένα έτοιμο template;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ένα custom-built site σχεδιάζεται αποκλειστικά για την ταυτότητα και τους στόχους σας, με ανώτερη ταχύτητα, ασφάλεια και SEO. Τα έτοιμα templates είναι φθηνότερα αλλά κοινότυπα, πιο αργά και δύσκολα ξεχωρίζουν στη Google." }},
    { "@type": "Question", "name": "Κατασκευάζετε e-shop με σύνδεση σε ERP και τράπεζες;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Υλοποιούμε πλήρεις διασυνδέσεις με ERP, τραπεζικά gateways, Viva/Stripe, IRIS, PayPal και μεταφορικές (ACS, Speedex) για αυτοματοποιημένη λειτουργία." }},
    { "@type": "Question", "name": "Αναλαμβάνετε projects εκτός Κρήτης;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Με έδρα το Ρέθυμνο, αναλαμβάνουμε projects υψηλών προδιαγραφών σε όλη την Ελλάδα και το εξωτερικό." }}
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Κατασκευή Ιστοσελίδων & E-shop",
  "provider": { "@id": "https://www.digiads.gr/#organization" },
  "areaServed": [
    { "@type": "City", "name": "Ρέθυμνο" },
    { "@type": "City", "name": "Χανιά" },
    { "@type": "City", "name": "Ηράκλειο" },
    { "@type": "AdministrativeArea", "name": "Κρήτη" }
  ],
  "description": "Custom κατασκευή ιστοσελίδων και e-shop με Next.js/Astro, 100/100 Lighthouse, στο Ρέθυμνο και σε όλη την Κρήτη.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog", "name": "Υπηρεσίες Web Development",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Κατασκευή Εταιρικής Ιστοσελίδας" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Κατασκευή E-shop / Ηλεκτρονικού Καταστήματος" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Web Application" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ιστοσελίδες για Ξενοδοχεία & Βίλες" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ιστοσελίδες για Rent a Car" }}
    ]
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Αρχική", "item": "https://www.digiads.gr/" },
    { "@type": "ListItem", "position": 2, "name": "Κατασκευή Ιστοσελίδων", "item": "https://www.digiads.gr/kataskevi-istoselidon" }
  ]
};
---

<Layout title={title} description={description} lang="el">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <Navbar />

    <!-- SEO Hero Section -->
    <section class="relative pt-40 pb-24 overflow-hidden bg-[#1B1F3B]">
        <!-- Aurora Glow Background -->
        <div class="absolute inset-0 z-0">
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-[#FFBF00]/10 blur-[120px] rounded-full mix-blend-screen animate-pulse pointer-events-none"></div>
            <div class="absolute bottom-0 right-1/4 w-[600px] h-[400px] bg-[#FFBF00]/10 blur-[100px] rounded-full mix-blend-screen pointer-events-none"></div>
        </div>

        <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
            <span class="text-[#FFBF00] font-mono tracking-[0.2em] uppercase text-sm mb-6 inline-block">Web Design Agency Crete</span>
            
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white font-montserrat tracking-tight leading-tight mb-6">
                Κατασκευή Ιστοσελίδων & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFBF00] to-[#FFBF00]">E-shop</span>
            </h1>

            <!-- Tech Badges -->
            <div class="flex flex-wrap justify-center gap-3 mb-8">
                <span class="px-4 py-1.5 rounded-full border border-[#FFBF00]/30 bg-[#FFBF00]/5 text-[#FFBF00] text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Next.js</span>
                <span class="px-4 py-1.5 rounded-full border border-[#FFBF00]/30 bg-[#FFBF00]/5 text-[#FFBF00] text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Astro</span>
                <span class="px-4 py-1.5 rounded-full border border-[#FFBF00]/30 bg-[#FFBF00]/5 text-green-400 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">100/100 Lighthouse</span>
                <span class="px-4 py-1.5 rounded-full border border-white/20 bg-white/5 text-slate-300 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Serverless</span>
            </div>
            
            <h2 class="text-xl md:text-2xl text-slate-300 font-light max-w-3xl mx-auto leading-relaxed mb-10">
                Δεν φτιάχνουμε απλώς site. Χτίζουμε <strong>ταχύτατα ψηφιακά περιουσιακά στοιχεία (assets)</strong> με 100/100 ταχύτητα που μετατρέπουν τους επισκέπτες σε πελάτες στο Ρέθυμνο, τα Χανιά και σε όλη την Ελλάδα.
            </h2>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                 <a href="/contact" class="px-8 py-4 bg-[#FFBF00] text-black rounded-full font-bold uppercase tracking-wider hover:bg-white hover:shadow-[0_0_30px_rgba(255, 191, 0,0.4)] transition-all duration-300 hover:-translate-y-1">
                    Ζητηστε Προσφορα
                 </a>
            </div>
        </div>
    </section>

    <!-- Core Features (H2 Content SEO) -->
    <section class="py-24 bg-[#1B1F3B] relative z-10 border-t border-white/5">
        <div class="max-w-[1400px] mx-auto px-6">
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/50 hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(255, 191, 0,0.2)] transition-all duration-300 group">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#FFBF00]/10 flex items-center justify-center text-[#FFBF00] group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">Εκρηκτική Ταχύτητα</h3>
                    <p class="text-slate-400 leading-relaxed">Χρησιμοποιούμε τεχνολογίες αιχμής όπως React, Next.js και Astro. Το e-shop ή η ιστοσελίδα σας φορτώνει σε χιλιοστά του δευτερολέπτου, προστατεύοντας τα rankings σας στη Google.</p>
                </div>
                <!-- Feature 2 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/50 hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(255, 191, 0,0.2)] transition-all duration-300 group">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#FFBF00]/10 flex items-center justify-center text-[#FFBF00] group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">Responsive Web Design</h3>
                    <p class="text-slate-400 leading-relaxed">Άψογη εμπειρία (Mobile First) σε κινητά και tablet. Η πλειοψηφία των πωλήσεων γίνεται από smartphones, ειδικά στον Τουρισμό της Κρήτης και το λιανεμπόριο.</p>
                </div>
                <!-- Feature 3 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/50 hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(34,197,94,0.2)] transition-all duration-300 group">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#FFBF00]/10 flex items-center justify-center text-green-400 group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">SEO & Core Web Vitals</h3>
                    <p class="text-slate-400 leading-relaxed">Custom κατασκευή που τηρεί αυστηρά τα κριτήρια της Google. Σωστή δομή H1/H2, JSON-LD Schema markup και βελτιστοποίηση εικόνων από την πρώτη μέρα.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Content Silo: Text-Heavy Section for Local SEO -->
    <section class="py-24 bg-[#1B1F3B]">
        <div class="max-w-4xl mx-auto px-6 prose prose-invert prose-lg prose-headings:font-montserrat leading-[1.7]">
            <h2 class="text-3xl font-bold text-white mb-6">Η Νο#1 Εταιρεία Κατασκευής Ιστοσελίδων στην Κρήτη</h2>
            <p class="text-slate-300 mb-8">
                Η παρουσία σας στο διαδίκτυο δεν είναι απλώς μια 'βιτρίνα'. Στη DIGIADS αντιμετωπίζουμε το <strong>custom web design</strong> ως δημιουργία ενός μηχανισμού πωλήσεων που συνδυάζεται άψογα με τη <a href="/digital-marketing/performance-marketing" class="text-[#FFBF00] underline hover:text-white transition-colors">διαφήμιση Google Ads</a>. Με έδρα το <strong>Ρέθυμνο</strong>, εξυπηρετούμε κορυφαίες επιχειρήσεις στα <strong>Χανιά, το Ηράκλειο</strong> και διαχειριζόμαστε projects (ξενοδοχεία, βίλες, rent a car, e-commerce) σε όλη την Ελλάδα. Ειδικά στον τουριστικό τομέα, αναλαμβάνουμε ολοκληρωμένο <a href="/touristiko-marketing" class="text-[#FFBF00] underline hover:text-white transition-colors">τουριστικό marketing για ξενοδοχεία</a> και βίλες.
            </p>

            <h2 class="text-3xl font-bold text-white mb-6 mt-12">Κατασκευή E-shop στο Ρέθυμνο & σε όλη την Κρήτη</h2>
            <p class="text-slate-300 mb-6">
                Η <strong>κατασκευή ηλεκτρονικού καταστήματος (e-shop)</strong> είναι μαθηματικά και User Experience (UX). Σχεδιάζουμε τη διαδρομή του πελάτη (funnel) βήμα-βήμα, μειώνοντας το cart abandonment rate και αυξάνοντας το Average Order Value (AOV). Δείτε τον <a href="/blog/kataskevi-eshop" class="text-[#FFBF00] underline hover:text-white transition-colors">αναλυτικό μας οδηγό για κατασκευή e-shop</a>.
            </p>
            <ul class="text-slate-300 space-y-3 mb-12 list-none pl-0">
                <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#FFBF00] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>Υποστήριξη πολλαπλών τρόπων πληρωμής (Πιστωτική, PayPal, Stripe, IRIS)</li>
                <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#FFBF00] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>Διασύνδεση με ERP (Soft1, Epsilon, Pylon) και μεταφορικές εταιρείες (Speedex, ACS)</li>
                <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#FFBF00] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>Full SEO Optimization σε Κατηγορίες και Προϊόντα, ακολουθώντας τον <a href="/blog/seo-odigos-google" class="text-[#FFBF00] underline hover:text-white transition-colors ml-1">πλήρη οδηγό SEO της Google</a>.</li>
            </ul>
        </div>
    </section>

    <!-- NEW SECTION 1: Τύποι Ιστοσελίδων -->
    <section class="py-24 bg-[#1B1F3B] border-t border-white/5 relative z-10">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat mb-6">Τι Είδους Ιστοσελίδα Χρειάζεστε;</h2>
                <p class="text-slate-400 text-lg max-w-3xl mx-auto">Κάθε επιχείρηση έχει διαφορετικές ανάγκες. Από την <strong>δημιουργία ιστοσελίδας</strong> παρουσίασης μέχρι το πλήρες <strong>ηλεκτρονικό κατάστημα</strong>, σχεδιάζουμε τη σωστή λύση για τον στόχο σας.</p>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                <!-- Type 1 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-12 h-12 mb-5 rounded-xl bg-[#FFBF00]/10 flex items-center justify-center text-blue-400">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-3">Εταιρική Ιστοσελίδα (Corporate)</h3>
                    <p class="text-slate-400 leading-relaxed">Η ψηφιακή σας ταυτότητα. Ιδανική για επαγγελματίες και επιχειρήσεις που θέλουν κύρος, αξιοπιστία και σταθερή ροή leads. Custom <strong>σχεδιασμός ιστοσελίδας</strong>, άψογο responsive design και τεχνικό SEO από την πρώτη μέρα.</p>
                </div>
                <!-- Type 2 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-12 h-12 mb-5 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-3">Κατασκευή E-shop</h3>
                    <p class="text-slate-400 leading-relaxed">Πουλήστε online 24/7. <strong>Κατασκευή ηλεκτρονικού καταστήματος</strong> με έμφαση στο conversion: γρήγορο checkout, ασφαλείς πληρωμές και βελτιστοποίηση για μέγιστες πωλήσεις. <a href="/blog/poso-kostizei-kataskevi-istoselidas" class="text-[#FFBF00] hover:underline">Δείτε πώς διαμορφώνεται το κόστος.</a></p>
                </div>
                <!-- Type 3 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-12 h-12 mb-5 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-400">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-3">Ξενοδοχεία, Βίλες & Rent a Car</h3>
                    <p class="text-slate-400 leading-relaxed">Εξειδίκευση στην τουριστική αγορά της Κρήτης. <strong>Ιστοσελίδες για ξενοδοχεία και ενοικιαζόμενα δωμάτια</strong> με μηχανή κρατήσεων, καθώς και λύσεις για <strong>rent a car</strong> που φέρνουν direct bookings και μειώνουν την εξάρτηση από OTAs (Booking, Airbnb).</p>
                </div>
                <!-- Type 4 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-12 h-12 mb-5 rounded-xl bg-[#FFBF00]/10 flex items-center justify-center text-[#FFBF00]">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-3">Custom Web Applications</h3>
                    <p class="text-slate-400 leading-relaxed">Για projects υψηλών απαιτήσεων: headless πλατφόρμες, συστήματα διαχείρισης B2B, portals και web apps. Χτισμένα σε σύγχρονο, ασφαλές stack (Jamstack) για ασταμάτητη λειτουργία και scaling.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION 2: Custom vs Template -->
    <section class="py-24 bg-[#1B1F3B]">
        <div class="max-w-4xl mx-auto px-6 prose prose-invert prose-lg prose-headings:font-montserrat leading-[1.7]">
            <h2 class="text-3xl font-bold text-white mb-6">Γιατί Custom Web Design & Όχι Έτοιμο Template;</h2>
            <p class="text-slate-300 mb-6">
                Πολλές εταιρείες προσφέρουν φθηνές ιστοσελίδες βασισμένες σε έτοιμα templates του WordPress. Το αποτέλεσμα; Κοινότυπα, αργά sites που δυσκολεύονται να ξεχωρίσουν στη Google. Στη DIGIADS, κάθε <strong>κατασκευή ιστοσελίδας</strong> είναι μοναδική, σχεδιασμένη αποκλειστικά για την ταυτότητα και τους εμπορικούς στόχους σας.
            </p>
            <p class="text-slate-300 mb-6">
