---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Astro/Navbar.astro';
import Footer from '../components/Astro/Footer.astro';
import SiteAuditor from '../components/React/SiteAuditor';
import TechShowcase from '../components/React/TechShowcase';

const title = "Κατασκευή Ιστοσελίδων Ρέθυμνο & Κρήτη | Κατασκευή E-shop & Ξενοδοχειακών Sites | DIGIADS";
const description = "Custom κατασκευή ιστοσελίδων & e-shop στο Ρέθυμνο και σε όλη την Κρήτη (Χανιά, Ηράκλειο, Άγιος Νικόλαος). 100/100 ταχύτητα Google PageSpeed, ιστοσελίδες ξενοδοχείων, βιλών, rent a car & προδιαγραφές ΕΣΠΑ WCAG 2.1 AA.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Πόσο κοστίζει η κατασκευή ιστοσελίδας ή e-shop στην Κρήτη;",
      "acceptedAnswer": { "@type": "Answer", "text": "Το κόστος εξαρτάται από τον τύπο (εταιρική ιστοσελίδα, τουριστικό site με μηχανή κρατήσεων ή e-shop) και τις απαιτήσεις. Κάθε έργο κοστολογείται με διαφάνεια βάσει των λειτουργιών, των διασυνδέσεων (ERP, τράπεζες, Channel Manager) και των γλωσσών. Ζητήστε δωρεάν προσφορά χωρίς δέσμευση." }},
    { "@type": "Question", "name": "Πόσος χρόνος χρειάζεται για την κατασκευή μιας ιστοσελίδας;",
      "acceptedAnswer": { "@type": "Answer", "text": "Μια custom εταιρική ή τουριστική ιστοσελίδα ολοκληρώνεται σε 15-20 εργάσιμες ημέρες, ενώ ένα πλήρες e-shop ή custom web application απαιτεί 30-45 ημέρες ανάλογα με τις διασυνδέσεις (ERP, XML προμηθευτών, τράπεζες)." }},
    { "@type": "Question", "name": "Αναλαμβάνετε κατασκευή ιστοσελίδων μέσω προγραμμάτων ΕΣΠΑ και με πρότυπο ΑμεΑ WCAG 2.1 AA;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Κατασκευάζουμε ιστοσελίδες και e-shop που πληρούν 100% τις τεχνικές προδιαγραφές των προγραμμάτων ΕΣΠΑ (Ψηφιακός Μετασχηματισμός ΜμΕ, Ενίσχυση Τουριστικών Επιχειρήσεων), συμπεριλαμβανομένης της πιστοποιημένης προσβασιμότητας ΑμεΑ κατά το πρότυπο WCAG 2.1 Επίπεδο AA και της πολυγλωσσικής υποστήριξης." }},
    { "@type": "Question", "name": "Οι ιστοσελίδες σας βγαίνουν στην πρώτη σελίδα της Google;",
      "acceptedAnswer": { "@type": "Answer", "text": "Χτίζουμε σε Next.js και Astro ( αλλά και σε βελτιστοποιημένο custom WordPress/WooCommerce όπου απαιτείται) εξασφαλίζοντας δείκτες Core Web Vitals έως 100/100, δομή H1-H3, JSON-LD Schema.org και AI Search (GEO) βελτιστοποίηση που δίνουν τεράστιο προβάδισμα έναντι του τοπικού ανταγωνισμού." }},
    { "@type": "Question", "name": "Αναλαμβάνετε ανακατασκευή (redesign) παλιάς ιστοσελίδας WordPress χωρίς απώλεια SEO;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Αναλαμβάνουμε την πλήρη ανακατασκευή και αναβάθμιση παλαιών ιστοσελίδων με χαρτογράφηση 301 redirects, διατήρηση και ενίσχυση των οργανικών κατατάξεων στη Google και πολλαπλασιασμό της ταχύτητας φόρτωσης." }},
    { "@type": "Question", "name": "Κατασκευάζετε e-shop με σύνδεση σε ERP, Skroutz/BestPrice και ελληνικές τράπεζες;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Υλοποιούμε πλήρεις διασυνδέσεις με ERP (Soft1, Epsilon, Pylon, Entersoft), αυτόματα XML feeds για Skroutz και BestPrice, τραπεζικά gateways (Eurobank, Πειραιώς, Alpha, Εθνική), Stripe, Viva Wallet, IRIS και εταιρείες courier (ACS, Speedex, Γενική Ταχυδρομική, Box Now)." }}
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Κατασκευή Ιστοσελίδων, E-shop & Τουριστικών Websites",
  "provider": { "@id": "https://www.digiads.gr/#organization" },
  "areaServed": [
    { "@type": "City", "name": "Ρέθυμνο" },
    { "@type": "City", "name": "Χανιά" },
    { "@type": "City", "name": "Ηράκλειο" },
    { "@type": "City", "name": "Άγιος Νικόλαος" },
    { "@type": "AdministrativeArea", "name": "Κρήτη" }
  ],
  "description": "Custom κατασκευή ιστοσελίδων, e-shop και τουριστικών ιστοσελίδων κρατήσεων με Next.js/Astro (100/100 Lighthouse) και εξειδικευμένο WordPress/WooCommerce, στο Ρέθυμνο και σε όλη την Κρήτη.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog", "name": "Υπηρεσίες Web Development Κρήτη",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Κατασκευή Ιστοσελίδων Ξενοδοχείων, Βιλών & Καταλυμάτων (Direct Booking)" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Κατασκευή Εταιρικής Ιστοσελίδας (Corporate Web Design)" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Κατασκευή E-shop με σύνδεση ERP, Τραπεζών & Skroutz/BestPrice" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ιστοσελίδες για Rent a Car, Moto Rental & Εκδρομές" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ιστοσελίδες ΕΣΠΑ & Πρότυπο Προσβασιμότητας ΑμεΑ WCAG 2.1 AA" }}
    ]
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Αρχική", "item": "https://www.digiads.gr/" },
    { "@type": "ListItem", "position": 2, "name": "Κατασκευή Ιστοσελίδων", "item": "https://www.digiads.gr/kataskevi-istoselidon" }
  ]
};
---

<Layout title={title} description={description} lang="el">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <Navbar />

    <!-- SEO Hero Section -->
    <section class="relative pt-40 pb-24 overflow-hidden bg-[#1B1F3B]">
        <!-- Aurora Glow Background -->
        <div class="absolute inset-0 z-0">
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-[#FFBF00]/10 blur-[120px] rounded-full mix-blend-screen animate-pulse pointer-events-none"></div>
            <div class="absolute bottom-0 right-1/4 w-[600px] h-[400px] bg-[#FFBF00]/10 blur-[100px] rounded-full mix-blend-screen pointer-events-none"></div>
        </div>

        <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
            <span class="text-[#FFBF00] font-mono tracking-[0.2em] uppercase text-sm mb-6 inline-block">Web Design & Development Agency • Ρεθυμνο, Κρητη</span>
            
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white font-montserrat tracking-tight leading-tight mb-6">
                Κατασκευή Ιστοσελίδων & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFBF00] to-[#FFD966]">E-shop στην Κρήτη</span>
            </h1>

            <!-- Tech Badges -->
            <div class="flex flex-wrap justify-center gap-3 mb-8">
                <span class="px-4 py-1.5 rounded-full border border-[#FFBF00]/30 bg-[#FFBF00]/5 text-[#FFBF00] text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Next.js & Astro</span>
                <span class="px-4 py-1.5 rounded-full border border-[#FFBF00]/30 bg-[#FFBF00]/5 text-green-400 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">100/100 Google PageSpeed</span>
                <span class="px-4 py-1.5 rounded-full border border-white/20 bg-white/5 text-slate-300 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Hotel & Villa Booking Sites</span>
                <span class="px-4 py-1.5 rounded-full border border-white/20 bg-white/5 text-slate-300 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">ΕΣΠΑ & WCAG 2.1 AA Ready</span>
            </div>
            
            <h2 class="text-xl md:text-2xl text-slate-300 font-light max-w-3xl mx-auto leading-relaxed mb-10">
                Δεν φτιάχνουμε απλώς «όμορφες βιτρίνες». Κατασκευάζουμε <strong>ταχύτατες μηχανές κρατήσεων και πωλήσεων</strong> με 100/100 απόδοση στη Google για επιχειρήσεις, ξενοδοχεία, βίλες και e-shop στο <strong>Ρέθυμνο, τα Χανιά, το Ηράκλειο</strong> και σε όλη την Ελλάδα.
            </h2>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                 <a href="/contact" class="px-8 py-4 bg-[#FFBF00] text-black rounded-full font-bold uppercase tracking-wider hover:bg-white hover:shadow-[0_0_30px_rgba(255, 191, 0,0.4)] transition-all duration-300 hover:-translate-y-1">
                    Ζητηστε Δωρεαν Προσφορα
                 </a>
                 <a href="/touristiko-marketing" class="px-8 py-4 bg-white/5 hover:bg-white/10 text-white border border-white/15 rounded-full font-semibold transition-all duration-300">
                    Τουριστικές Ιστοσελίδες & Direct Bookings →
                 </a>
            </div>
        </div>
    </section>

    <!-- Core Features (H2 Content SEO) -->
    <section class="py-24 bg-[#1B1F3B] relative z-10 border-t border-white/5">
        <div class="max-w-[1400px] mx-auto px-6">
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/50 hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(255, 191, 0,0.2)] transition-all duration-300 group">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#FFBF00]/10 flex items-center justify-center text-[#FFBF00] group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">Εκρηκτική Ταχύτητα (100/100)</h3>
                    <p class="text-slate-400 leading-relaxed">Χρησιμοποιούμε αρχιτεκτονική Next.js, Astro και βελτιστοποιημένο custom κώδικα. Η ιστοσελίδα ή το e-shop σας φορτώνει σε λιγότερο από 0.5 δευτερόλεπτα, μειώνοντας το κόστος διαφήμισης (CPC) και ανεβάζοντας τα οργανικά rankings στη Google.</p>
                </div>
                <!-- Feature 2 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/50 hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(255, 191, 0,0.2)] transition-all duration-300 group">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#FFBF00]/10 flex items-center justify-center text-[#FFBF00] group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">Mobile-First Conversion Design</h3>
                    <p class="text-slate-400 leading-relaxed">Πάνω από το 78% των κρατήσεων στον τουρισμό της Κρήτης και των αγορών σε e-shop γίνεται από κινητό. Σχεδιάζουμε κάθε οθόνη με γνώμονα την ευκολία πλοήγησης και την άμεση ολοκλήρωση κράτησης ή αγοράς.</p>
                </div>
                <!-- Feature 3 -->
                <div class="bg-[#14172E]/80 backdrop-blur-lg p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/50 hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(34,197,94,0.2)] transition-all duration-300 group">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#FFBF00]/10 flex items-center justify-center text-green-400 group-hover:scale-110 transition-transform">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">Τεχνικό SEO & AI Search (GEO)</h3>
                    <p class="text-slate-400 leading-relaxed">Κάθε ιστοσελίδα παραδίδεται με πλήρη υποδομή <a href="/digital-marketing/seo-local-seo" class="text-[#FFBF00] hover:underline">SEO & Local SEO</a>: σημασιολογική δομή H1-H3, JSON-LD Schema markup, αυτόματα sitemaps και βελτιστοποίηση για ChatGPT & Google AI Overviews.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW SECTION: Τύποι Ιστοσελίδων (Expanded with Tourism & ESPA) -->
    <section class="py-24 bg-[#1B1F3B] border-t border-white/5 relative z-10">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat mb-6">Εξειδικευμένες Λύσεις Κατασκευής Ιστοσελίδων</h2>
                <p class="text-slate-400 text-lg max-w-3xl mx-auto">Από την κατασκευή τουριστικής ιστοσελίδας με μηχανή κρατήσεων μέχρι σύνθετα B2C/B2B e-shop, σχεδιάζουμε την ιδανική λύση για τον κλάδο σας.</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Type 1: Hotels & Villas (Highlighted) -->
                <div class="bg-[#14172E] p-8 rounded-3xl border-2 border-[#FFBF00]/40 hover:border-[#FFBF00] hover:-translate-y-1 transition-all duration-300 relative">
                    <span class="absolute top-4 right-4 text-[10px] font-mono uppercase px-2.5 py-1 rounded-full bg-[#FFBF00]/20 text-[#FFBF00] font-bold">High Demand • Κρητη</span>
                    <h3 class="text-2xl font-bold text-white mb-3 mt-2">Ξενοδοχεία, Luxury Βίλες & Καταλύματα</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-4">
                        Custom ιστοσελίδες υψηλής αισθητικής με ενσωματωμένο <strong>Booking Engine (WebHotelier, PrimalRes, Beds24, Hosthub)</strong>, πολυγλωσσική υποστήριξη (EN, DE, FR) και στρατηγική <a href="/touristiko-marketing" class="text-[#FFBF00] hover:underline">αύξησης Direct Bookings</a> χωρίς προμήθειες OTA.
                    </p>
                </div>

                <!-- Type 2: Rent a Car & Tours -->
                <div class="bg-[#14172E]/80 p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-3 mt-2">Rent a Car, Moto & Yachting</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Ολοκληρωμένα συστήματα online κράτησης στόλου οχημάτων, μοτοσυκλετών, σκαφών και εκδρομών στην Κρήτη. Περιλαμβάνουν τιμοκαταλόγους ανά σεζόν (Low/Mid/High), επιλογή τοποθεσίας παράδοσης (Αεροδρόμιο Χανίων/Ηρακλείου, Ρέθυμνο), extras και online πληρωμή.
                    </p>
                </div>

                <!-- Type 3: E-shop -->
                <div class="bg-[#14172E]/80 p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-3 mt-2">Κατασκευή E-shop (B2C & B2B)</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        <strong>Κατασκευή ηλεκτρονικού καταστήματος</strong> με ταχύτατο one-page checkout, σύνδεση με <strong>ERP (Soft1, Epsilon, Pylon, Entersoft)</strong>, αυτόματα XML για <strong>Skroutz & BestPrice</strong>, πληρωμές με κάρτα/IRIS/Klarna και αυτόματη έκδοση voucher courier (ACS, Speedex, Box Now).
                    </p>
                </div>

                <!-- Type 4: Corporate -->
                <div class="bg-[#14172E]/80 p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-3 mt-2">Εταιρικές Ιστοσελίδες Κύρους</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Για τεχνικές εταιρείες, ιατρεία, δικηγορικά γραφεία, λογιστές, μεσιτικά γραφεία (Real Estate Κρήτη) και B2B επιχειρήσεις που απαιτούν κορυφαία εταιρική εικόνα, ταχύτητα 100/100 και συνεχή ροή ποιοτικών leads.
                    </p>
                </div>

                <!-- Type 5: ESPA & WCAG -->
                <div class="bg-[#14172E]/80 p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-3 mt-2">Ιστοσελίδες ΕΣΠΑ & Πρότυπο ΑμεΑ (WCAG 2.1 AA)</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Πλήρης συμμόρφωση με όλες τις προδιαγραφές επιδοτούμενων προγραμμάτων <strong>ΕΣΠΑ (Ψηφιακός Μετασχηματισμός ΜμΕ & Τουρισμού)</strong>, πιστοποιημένη προσβασιμότητα ΑμεΑ κατά <strong>WCAG 2.1 Επίπεδο AA</strong> και πολυγλωσσικό περιβάλλον.
                    </p>
                </div>

                <!-- Type 6: Redesign & Custom Apps -->
                <div class="bg-[#14172E]/80 p-8 rounded-3xl border border-[#FFBF00]/15 hover:border-[#FFBF00]/40 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="text-2xl font-bold text-white mb-3 mt-2">Ανακατασκευή (Redesign) & Web Apps</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Μετατρέπουμε παλιές, αργές ιστοσελίδες WordPress σε σύγχρονα, ασφαλή και ταχύτατα ψηφιακά συστήματα με πλήρη διατήρηση του SEO (301 redirects), ή αναπτύσσουμε custom B2B portals και AI εργαλεία.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- NEW COMPETITIVE COMPARISON TABLE: DIGIADS vs Traditional WordPress Agencies -->
    <section class="py-24 bg-[#14172E]/60 border-t border-white/5 relative z-10">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-14">
                <span class="text-[#FFBF00] font-mono text-xs uppercase tracking-widest block mb-2">Γιατι Ξεχωριζουμε στην Κρητη</span>
                <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat mb-4">
                    Custom Αρχιτεκτονική DIGIADS vs Κοινά Έτοιμα Templates
                </h2>
                <p class="text-slate-400 max-w-2xl mx-auto text-sm md:text-base">
                    Δείτε γιατί οι επιχειρήσεις σε Ρέθυμνο, Χανιά και Ηράκλειο επιλέγουν τη DIGIADS αντί για ένα τυποποιημένο, αργό template:
                </p>
            </div>

            <div class="overflow-x-auto rounded-3xl border border-white/10 bg-[#1B1F3B] shadow-2xl">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-white/10 bg-[#14172E]">
                            <th class="p-5 text-slate-300 font-semibold">Κριτήριο Απόδοσης</th>
                            <th class="p-5 text-[#FFBF00] font-bold">DIGIADS Custom (Next.js / Astro / Pro Stack)</th>
                            <th class="p-5 text-slate-400 font-semibold">Τυπικό Έτοιμο Template Ανταγωνισμού</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 text-slate-300">
                        <tr>
                            <td class="p-5 font-medium text-white">Χρόνος Φόρτωσης σε Κινητό</td>
                            <td class="p-5 text-emerald-400 font-bold">⚡ 0.3 – 0.6 δευτερόλεπτα (Ακαριαίο)</td>
                            <td class="p-5 text-slate-400">3.5 – 6.5+ δευτερόλεπτα</td>
                        </tr>
                        <tr>
                            <td class="p-5 font-medium text-white">Google PageSpeed / Core Web Vitals</td>
                            <td class="p-5 text-emerald-400 font-bold">✓ 95 – 100 / 100</td>
                            <td class="p-5 text-slate-400">40 – 65 / 100 (λόγω 20+ βαριών plugins)</td>
                        </tr>
                        <tr>
