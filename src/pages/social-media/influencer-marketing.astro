---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Astro/Navbar.astro';
import Footer from '../../components/Astro/Footer.astro';

const title = "Influencer Marketing Κρήτη | Συνεργασίες με Creators | DIGIADS";
const description = "Στρατηγικές συνεργασίες με Έλληνες influencers & micro-influencers για επιχειρήσεις στην Κρήτη. Vetting, διαπραγμάτευση, UGC content, μετρήσιμα αποτελέσματα.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Πόσο κοστίζει μια καμπάνια influencer marketing;",
      "acceptedAnswer": { "@type": "Answer", "text": "Εξαρτάται από το μέγεθος και τον αριθμό των influencers. Ενδεικτικά, οι micro-influencers (10.000-50.000 followers) κοστίζουν 100-500€ ανά δημοσίευση, ενώ mid-tier και macro influencers κοστίζουν σημαντικά περισσότερο. Ζητήστε δωρεάν αξιολόγηση για προσφορά προσαρμοσμένη στους στόχους σας." }},
    { "@type": "Question", "name": "Πόσους influencers χρειάζομαι για την πρώτη μου καμπάνια;",
      "acceptedAnswer": { "@type": "Answer", "text": "Συχνά συστήνουμε συνεργασία με 3-5 micro-influencers αντί για έναν μεγάλο. Αυτό μοιράζει το ρίσκο, παράγει περισσότερο περιεχόμενο και επιτρέπει σύγκριση αποτελεσμάτων μεταξύ διαφορετικών δημιουργών." }},
    { "@type": "Question", "name": "Πώς ξεχωρίζετε τους πραγματικούς influencers από όσους έχουν αγορασμένους followers;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ελέγχουμε το engagement rate σε σχέση με τον αριθμό ακολούθων, την ποιότητα των σχολίων και το ιστορικό δραστηριότητας του λογαριασμού. Δυσανάλογα χαμηλό engagement ή γενικά, ασχετα σχόλια είναι κόκκινη σημαία για αγορασμένο κοινό." }},
    { "@type": "Question", "name": "Αναλαμβάνετε influencer marketing ειδικά για ξενοδοχεία και βίλες στην Κρήτη;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι, είναι μία από τις βασικές μας ειδικεύσεις. Οργανώνουμε συνεργασίες και ταξίδια εξοικείωσης με ταξιδιωτικούς δημιουργούς περιεχομένου, παράγοντας αυθεντικό υλικό που οδηγεί σε direct bookings." }},
    { "@type": "Question", "name": "Ποια είναι η διαφορά ανάμεσα σε influencer marketing και UGC;",
      "acceptedAnswer": { "@type": "Answer", "text": "Το influencer marketing αφορά συνεργασία με δημιουργούς που έχουν δικό τους κοινό και δημοσιεύουν στο προφίλ τους. Το UGC (User Generated Content) είναι περιεχόμενο σε στυλ δημιουργού που παράγεται ειδικά για να χρησιμοποιηθεί ως διαφημιστικό υλικό στα δικά σας κανάλια, χωρίς απαραίτητα ο δημιουργός να έχει μεγάλο κοινό." }},
    { "@type": "Question", "name": "Είναι υποχρεωτική η σήμανση #ad στις δημοσιεύσεις;",
      "acceptedAnswer": { "@type": "Answer", "text": "Ναι. Η ελληνική νομοθεσία απαιτεί σαφή σήμανση διαφημιστικού περιεχομένου (π.χ. #ad, #sponsored) όταν υπάρχει εμπορική συνεργασία. Διασφαλίζουμε ότι όλες οι συνεργασίες που διαχειριζόμαστε συμμορφώνονται πλήρως." }}
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Influencer Marketing",
  "provider": { "@id": "https://www.digiads.gr/#organization" },
  "areaServed": [
    { "@type": "City", "name": "Ρέθυμνο" },
    { "@type": "City", "name": "Χανιά" },
    { "@type": "City", "name": "Ηράκλειο" },
    { "@type": "AdministrativeArea", "name": "Κρήτη" },
    { "@type": "Country", "name": "Ελλάδα" }
  ],
  "description": "Στρατηγικές συνεργασίες με Έλληνες influencers και micro-influencers, vetting, διαπραγμάτευση και μέτρηση ROI για επιχειρήσεις στην Κρήτη.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog", "name": "Υπηρεσίες Influencer Marketing",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Εντοπισμός & Vetting Influencers" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Διαπραγμάτευση & Συμβόλαια" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "UGC Content Production" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Influencer Marketing για Τουρισμό" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Μέτρηση & Reporting Καμπανιών" }}
    ]
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Αρχική", "item": "https://www.digiads.gr/" },
    { "@type": "ListItem", "position": 2, "name": "Social Media", "item": "https://www.digiads.gr/digital-marketing/social-media-management" },
    { "@type": "ListItem", "position": 3, "name": "Influencer Marketing", "item": "https://www.digiads.gr/social-media/influencer-marketing" }
  ]
};
---

<Layout title={title} description={description} lang="el">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <Navbar />

    <!-- SEO Hero Section -->
    <section class="relative pt-40 pb-24 overflow-hidden bg-[#010205] min-h-[85vh] flex items-center">
        <!-- Abstract Network/Connection Motif Background -->
        <div class="absolute inset-0 z-0 flex items-center justify-center opacity-10 pointer-events-none">
            <!-- Nodes connecting -->
            <svg class="absolute w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <circle cx="20" cy="30" r="1.5" fill="#a855f7" />
                <circle cx="50" cy="50" r="2" fill="#3b82f6" />
                <circle cx="80" cy="40" r="1.5" fill="#a855f7" />
                <circle cx="30" cy="70" r="1" fill="#3b82f6" />
                <circle cx="70" cy="80" r="1.5" fill="#a855f7" />
                <line x1="20" y1="30" x2="50" y2="50" stroke="url(#grad)" stroke-width="0.2" />
                <line x1="50" y1="50" x2="80" y2="40" stroke="url(#grad)" stroke-width="0.2" />
                <line x1="20" y1="30" x2="30" y2="70" stroke="url(#grad)" stroke-width="0.2" />
                <line x1="30" y1="70" x2="50" y2="50" stroke="url(#grad)" stroke-width="0.2" />
                <line x1="50" y1="50" x2="70" y2="80" stroke="url(#grad)" stroke-width="0.2" />
                <line x1="80" y1="40" x2="70" y2="80" stroke="url(#grad)" stroke-width="0.2" />
                <defs>
                    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#a855f7;stop-opacity:1" />
                    </linearGradient>
                </defs>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-t from-[#010205] to-transparent"></div>
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(59,130,246,0.05)_0%,transparent_70%)]"></div>
        </div>

        <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
            <span class="text-purple-400 font-mono tracking-[0.2em] uppercase text-sm mb-6 inline-block font-bold">Authentic Content Creators</span>
            
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white font-montserrat tracking-tight leading-[1.1] mb-6">
                Influencer <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500">Marketing.</span>
            </h1>

            <div class="flex flex-wrap justify-center gap-3 mb-8">
                <span class="px-4 py-1.5 rounded-full border border-blue-500/30 bg-blue-500/5 text-blue-300 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Nano & Micro Influencers</span>
                <span class="px-4 py-1.5 rounded-full border border-purple-500/30 bg-purple-500/5 text-purple-300 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">UGC Content</span>
                <span class="px-4 py-1.5 rounded-full border border-blue-400/30 bg-blue-400/5 text-blue-200 text-xs font-mono font-bold tracking-wide backdrop-blur-sm">Data-Driven Vetting</span>
            </div>
            
            <h2 class="text-xl md:text-2xl text-slate-300 font-light max-w-3xl mx-auto leading-relaxed mb-10">
                Συνεργαστείτε με τους σωστούς <strong>δημιουργούς περιεχομένου</strong> στην Ελλάδα. Μετατρέψτε την επιρροή τους σε πραγματικές πωλήσεις και κρατήσεις για την επιχείρησή σας.
            </h2>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                 <a href="/contact" class="px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-full font-bold uppercase tracking-wider hover:from-blue-500 hover:to-purple-500 hover:shadow-[0_0_30px_rgba(168,85,247,0.4)] transition-all duration-300 hover:-translate-y-1">
                    ΒΡΕΣ ΤΟΝ ΙΔΑΝΙΚΟ INFLUENCER
                 </a>
            </div>
        </div>
    </section>

    <!-- SECTION 1: Γιατί Influencer Marketing -->
    <section class="py-24 bg-[#02040A] relative border-t border-white/5">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-8">Γιατί το Influencer Marketing Λειτουργεί</h2>
            <p class="text-slate-300 text-lg leading-[1.8] font-light">
                Οι καταναλωτές εμπιστεύονται όλο και λιγότερο την παραδοσιακή διαφήμιση και όλο και περισσότερο τις συστάσεις ανθρώπων που ήδη ακολουθούν και εμπιστεύονται. Το <strong>influencer marketing</strong> αξιοποιεί ακριβώς αυτή τη σχέση εμπιστοσύνης — μετατρέποντας αυθεντικούς δημιουργούς περιεχομένου (<a href="/social-media/tiktok-reels" class="text-purple-400 hover:underline">content creators Κρήτη</a>) σε brand ambassadors, με αποτελέσματα (ακόμα και μέσω <strong>product seeding</strong>) που η κλασική διαφήμιση δύσκολα πετυχαίνει.
            </p>
        </div>
    </section>

    <!-- SECTION 2: Τι Αναλαμβάνουμε (Service Description) -->
    <section class="py-24 bg-[#010205] relative z-10 border-t border-white/5">
        <div class="max-w-6xl mx-auto px-6">
            <h2 class="text-3xl md:text-4xl font-black text-white font-montserrat text-center mb-16">Τι Αναλαμβάνουμε σε Μια Influencer Καμπάνια</h2>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-[#050814]/80 backdrop-blur-lg p-8 rounded-3xl border border-white/5 hover:border-purple-500/30 transition-colors duration-300">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-400">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Εντοπισμός & Vetting Influencers</h3>
                    <p class="text-slate-400 leading-relaxed font-light text-sm">Βρίσκουμε δημιουργούς που ταιριάζουν πραγματικά στο brand και το κοινό σας. Ελέγχουμε engagement rate, αυθεντικότητα κοινού και ιστορικό συνεργασιών, αποφεύγοντας λογαριασμούς με αγορασμένους followers.</p>
                </div>
                <!-- Card 2 -->
                <div class="bg-[#050814]/80 backdrop-blur-lg p-8 rounded-3xl border border-white/5 hover:border-blue-500/30 transition-colors duration-300">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Διαπραγμάτευση & Συμβόλαια</h3>
                    <p class="text-slate-400 leading-relaxed font-light text-sm">Αναλαμβάνουμε την επικοινωνία, τη διαπραγμάτευση αμοιβής και τη σύνταξη σαφών συμφωνιών παραδοτέων, χρονοδιαγράμματος και δικαιωμάτων χρήσης περιεχομένου.</p>
                </div>
                <!-- Card 3 -->
                <div class="bg-[#050814]/80 backdrop-blur-lg p-8 rounded-3xl border border-white/5 hover:border-[#00d9ff]/30 transition-colors duration-300">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-[#00d9ff]/10 flex items-center justify-center text-[#00d9ff]">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Creative Direction</h3>
                    <p class="text-slate-400 leading-relaxed font-light text-sm">Καθοδηγούμε τη δημιουργία περιεχομένου ώστε να παραμένει αυθεντικό στο ύφος του influencer, αλλά ευθυγραμμισμένο με τους στόχους του brand σας.</p>
                </div>
                <!-- Card 4 -->
                <div class="bg-[#050814]/80 backdrop-blur-lg p-8 rounded-3xl border border-white/5 hover:border-purple-500/30 transition-colors duration-300">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-400">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">UGC Content Repurposing</h3>
                    <p class="text-slate-400 leading-relaxed font-light text-sm">Το <strong>UGC (User Generated Content)</strong> που παράγουν αξιοποιείται περαιτέρω ως <a href="/social-media/diafimisi-facebook-instagram" class="text-purple-400 hover:underline">υλικό σε Facebook & Instagram Ads</a> — αποδίδει κορυφαία σε conversions.</p>
                </div>
                <!-- Card 5 -->
                <div class="bg-[#050814]/80 backdrop-blur-lg p-8 rounded-3xl border border-white/5 hover:border-blue-500/30 transition-colors duration-300">
                    <div class="w-12 h-12 mb-6 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">Παρακολούθηση & Μέτρηση ROI</h3>
                    <p class="text-slate-400 leading-relaxed font-light text-sm">UTM tracking, promo codes και ανάλυση απόδοσης ανά creator, ώστε να ξέρετε ακριβώς ποια συνεργασία απέδωσε και έφερε πωλήσεις.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 3: Tiers / Ο Οδηγός Επιλογής -->
    <section class="py-24 bg-[#02040A] relative border-t border-white/5">
        <div class="max-w-6xl mx-auto px-6">
            <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-6">Nano, Micro, Mid-Tier ή Macro;</h2>
            <p class="text-center text-slate-400 mb-16 max-w-3xl mx-auto font-light text-lg">Δεν χρειάζεστε πάντα τον influencer με τους περισσότερους ακόλουθους — χρειάζεστε αυτόν με το πιο σχετικό, αφοσιωμένο κοινό.</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Nano -->
                <div class="bg-[#050814]/50 border border-white/5 p-6 rounded-2xl relative overflow-hidden group hover:border-slate-500/50 transition-colors">
                    <div class="text-slate-500 font-mono text-sm mb-4">1K - 10K Followers</div>
                    <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                        Nano
                        <span class="w-2 h-2 rounded-full bg-slate-500 block"></span>
                    </h3>
                    <p class="text-slate-400 text-sm font-light">Εξαιρετική αυθεντικότητα και τοπική σχέση με το κοινό (π.χ. τοπικοί <strong>nano influencers</strong> στο Ρέθυμνο/Κρήτη). Ιδανικό σημείο εκκίνησης για τοπικές καμπάνιες.</p>
                </div>
                <!-- Micro -->
                <div class="bg-[#050814]/50 border border-[#3b82f6]/20 p-6 rounded-2xl relative overflow-hidden group hover:border-[#3b82f6]/60 transition-colors">
                    <div class="text-[#3b82f6] font-mono text-sm mb-4">10K - 50K Followers</div>
                    <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                        Micro
                        <span class="w-3 h-3 rounded-full bg-[#3b82f6] block shadow-[0_0_10px_rgba(59,130,246,0.6)]"></span>
                    </h3>
                    <p class="text-slate-400 text-sm font-light">Το "sweet spot" για τις περισσότερες ελληνικές επιχειρήσεις — υψηλό engagement rate (3-6%) διατηρώντας αυθεντικότητα και λογικό κόστος.</p>
                </div>
                <!-- Mid-Tier -->
                <div class="bg-[#050814]/50 border border-[#8b5cf6]/20 p-6 rounded-2xl relative overflow-hidden group hover:border-[#8b5cf6]/60 transition-colors">
                    <div class="text-[#8b5cf6] font-mono text-sm mb-4">50K - 200K Followers</div>
                    <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                        Mid-Tier
                        <span class="w-4 h-4 rounded-full bg-[#8b5cf6] block shadow-[0_0_12px_rgba(139,92,246,0.6)]"></span>
                    </h3>
                    <p class="text-slate-400 text-sm font-light">Ευρύτερη αναγνωρισιμότητα, πιο επαγγελματική δομή συνεργασίας, κατάλληλο για e-shops & brands που θέλουν κλίμακα σε πανελλαδικό επίπεδο.</p>
                </div>
                <!-- Macro -->
                <div class="bg-[#050814]/50 border border-[#ec4899]/20 p-6 rounded-2xl relative overflow-hidden group hover:border-[#ec4899]/60 transition-colors">
                    <div class="text-[#ec4899] font-mono text-sm mb-4">200K+ Followers</div>
                    <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
                        Macro
                        <span class="w-5 h-5 rounded-full bg-[#ec4899] block shadow-[0_0_15px_rgba(236,72,153,0.6)]"></span>
                    </h3>
                    <p class="text-slate-400 text-sm font-light">Μέγιστη εμβέλεια για μαζικά λανσαρίσματα και εθνικές καμπάνιες αναγνωρισιμότητας (awareness) με γνωστά πρόσωπα (celebrities/top creators).</p>
                </div>
            </div>
            
            <div class="mt-12 bg-gradient-to-r from-[#050814] to-[#0a0f25] border border-blue-500/20 p-6 rounded-2xl text-center shadow-[0_10px_30px_rgba(59,130,246,0.1)]">
                <p class="text-slate-300 font-light">
                    <strong class="text-white">Η σύστασή μας:</strong> 3-5 συνεργασίες με micro-influencers αποδίδουν συχνά καλύτερα από μία με έναν μεγάλο — μοιράζεστε το ρίσκο, αποκτάτε πολλαπλάσιο <strong>UGC content</strong> και συγκρίνετε αποτελέσματα.
                </p>
            </div>
        </div>
    </section>

    <!-- SECTION 4: Τουρισμός (Τοπικό Πλεονέκτημα) -->
    <section class="py-24 bg-[#010205] relative border-t border-white/5 overflow-hidden">
        <div class="max-w-5xl mx-auto px-6 relative z-10">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl font-bold text-white mb-6">Influencer Marketing για Ξενοδοχεία & Βίλες στην Κρήτη</h2>
                    <p class="text-slate-300 mb-6 font-light leading-relaxed">
                        Ο τουρισμός (ξενοδοχεία, εστιατόρια) είναι από τους πιο ενεργούς κλάδους σε <strong>influencer travel marketing</strong> — και η Κρήτη προσφέρει ανεξάντλητο οπτικό υλικό. 
                    </p>
